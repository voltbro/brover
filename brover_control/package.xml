<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brover_control</name>
  <version>0.0.0</version>
  <description>Launch and shared configuration package for BRover ROS nodes.</description>
  <maintainer email="sashavera1998@gmail.com">pi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>brover_bat_monitor</exec_depend>
  <exec_depend>brover_imu_node</exec_depend>
  <exec_depend>brover_move_control</exec_depend>
  <exec_depend>brover_odom_simple</exec_depend>
  <exec_depend>brover_radiolink_control</exec_depend>
  <exec_depend>cyphal_ros2_bridge</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
