<launch>
  <arg name="brover_params" default="$(find-pkg-share brover_control)/config/brover_params.yaml"/>
  <arg name="cyphal_config_file" default="$(find-pkg-share cyphal_ros2_bridge)/examples/test_node.json"/>

  <node pkg="cyphal_ros2_bridge" exec="cyphal_bridge" args="--ros-args -p config_file:=$(var cyphal_config_file)"/>
  <node pkg="brover_move_control" exec="move_node" name="control_move">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="brover_radiolink_control" exec="direct_joystick_node" name="joy"/>
  <node pkg="brover_radiolink_control" exec="radiolink_node" name="radiolink_control">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="brover_imu_node" exec="imu_node" name="imu">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="brover_odom_simple" exec="odom_pose2d" name="odom">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="brover_bat_monitor" exec="bat_monitor_node" name="bat_monitor">
    <param from="$(var brover_params)"/>
  </node>
</launch>
