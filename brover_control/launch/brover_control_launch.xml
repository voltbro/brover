<launch>
 <node
        pkg="cyphal_ros2_bridge"
        exec="cyphal_bridge"
        name="cyphal_bridge_test"
        output="screen">
        <param
            name="config_file"
            value="/home/pi/ros2_ws/src/cyphal_ros2_bridge/examples/test_node.json"/>
    </node>

    <node
        pkg="cyphal_ros2_bridge"
        exec="cyphal_bridge"
        name="cyphal_bridge_power"
        output="screen">
        <param
            name="config_file"
            value="/home/pi/ros2_ws/src/cyphal_ros2_bridge/examples/power.json"/>
 </node>
 <arg name="brover_params" default="$(find-pkg-share brover_control)/config/brover_params.yaml"/>
 <node pkg="brover_move_control" exec="move_node" name="control_move">
    <param from="$(var brover_params)"/>
 </node>
 <node pkg="joy" exec="joy_node" name="joy"/>
  <node pkg="brover_radiolink_control" exec="radiolink_node" name="radiolink_control">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="brover_imu_node" exec="imu_node" name="imu">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="brover_odom_simple" exec="odom_pose2d" name="odom">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="brover_bat_monitor" exec="bat_monitor_node" name="bat_monitor">
    <param from="$(var brover_params)"/>
  </node>
  <node pkg="rele_control" exec="rele_control" name="rele_control">
  </node>

</launch>
